# OpenCode2API resolved configuration
# Copy to .env and edit only the values you need.
# Precedence: CLI arguments > environment > opencode2api.toml > defaults.

# ============================================================
# BRIDGE HTTP SERVER
# Controls where the Anthropic-compatible API listens.
# ============================================================
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=4000
# BRIDGE_MAX_BODY_SIZE=10485760
# BRIDGE_STREAM_BUFFER_SIZE=4096
# BRIDGE_CHANNEL_CAPACITY=256

# ============================================================
# OPENCODE UPSTREAM
# Controls the OpenAI-compatible upstream used by the bridge.
# ============================================================
# OPENCODE_UPSTREAM_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_PORT=4096
# OPENCODE_MODEL=opencode/deepseek-v4-flash-free
# BRIDGE_MIN_REASONING_STREAM_TOKENS=1024

# ============================================================
# CLIENT API AUTHENTICATION
# Protects the public Anthropic-compatible /v1/* API.
# Multiple tokens are comma-separated. Empty/unset means disabled.
# Non-loopback binding requires this setting.
# ============================================================
# BRIDGE_AUTH_TOKEN=replace-with-client-token-a,replace-with-client-token-b

# ============================================================
# MANAGEMENT AUTHENTICATION
# DASHBOARD_ADMIN_TOKEN protects browser dashboard endpoints and cookies.
# REST_API_TOKEN protects /api/v1/* with Authorization: Bearer.
# REST falls back to DASHBOARD_ADMIN_TOKEN when REST_API_TOKEN is unset.
# Never put these values in URLs, logs, screenshots, or source control.
# ============================================================
# DASHBOARD_ADMIN_TOKEN=replace-with-a-long-random-dashboard-token
# REST_API_TOKEN=replace-with-a-different-long-random-rest-token
# DASHBOARD_CSRF_ENABLED=true
# BRIDGE_CONFIG_PATH=opencode2api.toml

# ============================================================
# LOCAL SHELL DELEGATION
# Controls !command delegation to the Claude Code client.
# The bridge does not directly execute the delegated command in HTTP handlers.
# ============================================================
# BRIDGE_SHELL_POLICY=disabled
# BRIDGE_SHELL_ALLOWLIST=git,ls,pwd,cat,find,grep,echo,wc,head,tail,diff

# ============================================================
# REQUEST CONCURRENCY AND OBSERVABILITY
# BRIDGE_RATE_LIMIT is the maximum number of concurrent API requests.
# ============================================================
# BRIDGE_RATE_LIMIT=10
# BRIDGE_METRICS_ENABLED=true
# BRIDGE_REQUEST_ID_HEADER=x-request-id

# ============================================================
# MODEL FALLBACK AND RETRY POLICY
# These settings configure upstream retry behavior, not Docker lifecycle.
# ============================================================
# OPENCODE_MODEL_FALLBACKS=opencode/deepseek-v4-flash-free,opencode/nemotron-3-ultra-free
# OPENCODE_ENABLE_DEFAULT_FALLBACKS=false
# BRIDGE_MAX_NETWORK_ATTEMPTS=5
# BRIDGE_MAX_PROVIDER_ATTEMPTS=1
# BRIDGE_RETRY_BASE_BACKOFF_MS=2000
# BRIDGE_RETRY_MAX_BACKOFF_MS=16000

# ============================================================
# EGRESS ROUTING MODE
# direct: upstream requests leave through the host network.
# proxy: requests must use the configured proxy pool and fail closed.
# Direct fallback is intentionally forbidden in proxy mode.
# ============================================================
# BRIDGE_EGRESS_MODE=proxy
# BRIDGE_ALLOW_DIRECT_FALLBACK=false
# BRIDGE_ACTIVE_PROXY_COUNT=3

# ============================================================
# PRIMARY MANAGED WARP PROXIES
# Normal request traffic is sticky-routed across these nodes.
# ============================================================
# BRIDGE_PRIMARY_PROXIES=socks5h://127.0.0.1:40001,socks5h://127.0.0.1:40002,socks5h://127.0.0.1:40003

# ============================================================
# WARM-STANDBY PROTECTED WARP PROXIES
# Used only when eligible primary routes are unavailable.
# The application must never restart, stop, purge, or recreate these nodes.
# ============================================================
# BRIDGE_WARM_STANDBY_PROXIES=socks5h://127.0.0.1:40004,socks5h://127.0.0.1:40005

# ============================================================
# EXIT-ID VERIFICATION
# Identity endpoints are queried through each proxy.
# Strict mode requires enough unique verified public exit identities.
# ============================================================
# BRIDGE_REQUIRE_VERIFIED_EXIT_IP=false
# BRIDGE_MINIMUM_UNIQUE_EXIT_IPS=1
# BRIDGE_IDENTITY_ENDPOINTS=https://cloudflare.com/cdn-cgi/trace,https://api.ipify.org?format=json
# BRIDGE_IDENTITY_TTL_SECS=300

# ============================================================
# PROXY HEALTH AND RESTART WORKERS
# Controls monitor cadence and managed-primary restart policy.
# ============================================================
# BRIDGE_PROXY_HEALTH_INTERVAL_SECS=10
# BRIDGE_PROXY_RESTART_INTERVAL_SECS=2
# BRIDGE_MAX_PROXY_RESTART_ATTEMPTS=3

# ============================================================
# DOCKER / WARP INFRASTRUCTURE
# Controls external binaries and the managed WARP image.
# ============================================================
# BRIDGE_DOCKER_BINARY=docker
# BRIDGE_WARP_CLI_BINARY=warp-cli
# BRIDGE_WARP_IMAGE=ghcr.io/mon-ius/docker-warp-socks:latest
# RUNTIME_DIR=/home/user/.opencode2api
# BRIDGE_WORKER_SHUTDOWN_TIMEOUT_SECS=10
# BRIDGE_SERVER_SHUTDOWN_TIMEOUT_SECS=15

# ============================================================
# WEB SEARCH ORCHESTRATION
# Configures the bridge search subsystem, not upstream LLM retry.
# Fallback order: Tavily -> Exa -> Serper -> SearXNG -> DuckDuckGo.
# All result counts, response bytes, snippets, and request time are bounded.
# ============================================================
# BRIDGE_MAX_SEARCH_LOOPS=5
# BRIDGE_SEARCH_MAX_RESULTS=5
# BRIDGE_SEARCH_MAX_SNIPPET_CHARS=500
# BRIDGE_SEARCH_MAX_RESPONSE_BYTES=1048576
# BRIDGE_SEARCH_TIMEOUT_SECS=15

# ============================================================
# SEARCH PROVIDER CREDENTIALS
# These secrets authenticate only the named search provider.
# They are redacted from config snapshots, REST responses, and logs.
# ============================================================
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...
# SERPER_API_KEY=...
# SEARXNG_API_KEY=...

# ============================================================
# SEARCH PROVIDER ENDPOINTS
# These URLs configure HTTP adapters used by the search subsystem.
# Defaults point to the official public services.
# Override primarily for controlled tests or approved private deployments.
# ============================================================
# TAVILY_API_URL=https://api.tavily.com/search
# EXA_API_URL=https://api.exa.ai/search
# SERPER_API_URL=https://google.serper.dev/search
# DUCKDUCKGO_SEARCH_URL=https://html.duckduckgo.com/html/
# SEARXNG_URL=https://searxng.example.com

# ============================================================
# PRIVATE SEARXNG SECURITY EXCEPTION
# false rejects localhost, private, link-local, and .local SearXNG addresses.
# Set true only when intentionally connecting to a trusted internal instance.
# ============================================================
# BRIDGE_ALLOW_PRIVATE_SEARXNG=false
