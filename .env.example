# Bridge configuration for Claude Code
# Copy this file to .env and fill in your values
# Priority: CLI args > Environment vars > TOML file > Defaults

# === Server ===
# BRIDGE_PORT=4000
# BRIDGE_HOST=127.0.0.1

# === LLM ===
# OPENCODE_PORT=4096
# OPENCODE_MODEL=opencode/deepseek-v4-flash-free

# === Security ===
# Token used to secure the browser dashboard and its internal /api/dashboard/* endpoints.
# The dashboard fails closed when this value is missing or empty.
# DASHBOARD_ADMIN_TOKEN=replace-with-a-long-random-token

# Token used by the versioned REST management API under /api/v1/*.
# Clients must send: Authorization: Bearer <REST_API_TOKEN>
# When REST_API_TOKEN is unset, the REST API falls back to DASHBOARD_ADMIN_TOKEN.
# If both are missing, all /api/v1/* requests return HTTP 401.
# REST_API_TOKEN=replace-with-a-different-long-random-token

# Authentication tokens accepted by Claude Code / Anthropic-compatible /v1 endpoints.
# BRIDGE_AUTH_TOKEN=sk-abc,sk-xyz   # comma-separated tokens, unset = client auth disabled

# Shell execution policy for local !command requests.
# BRIDGE_SHELL_POLICY=unrestricted   # disabled | allowlist | unrestricted
# BRIDGE_SHELL_ALLOWLIST=git,ls,pwd,cat,echo

# === Limits ===
# BRIDGE_MAX_BODY_SIZE=1048576       # 1MB
# BRIDGE_MAX_SEARCH_LOOPS=5
# BRIDGE_RATE_LIMIT=                # max concurrent requests, unset = unlimited

# === Web Search API Keys ===
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...
# SERPER_API_KEY=...
# SEARXNG_URL=https://searxng.example.com
# SEARXNG_API_KEY=...
